generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
}
model Type {
  typeId Int @id @default(autoincrement()) @db.UnsignedInt
  name String @unique @db.VarChar(120)
  menus Menu[]
  @@map("types")
}
model Menu {
  menuId Int @id @default(autoincrement()) @db.UnsignedInt
  name String @db.VarChar(180)
  price Decimal @db.Decimal(10,2)
  isBestSeller Boolean @default(false)
  typeId Int @db.UnsignedInt
  type Type @relation(fields:[typeId],references:[typeId],onDelete:Restrict,onUpdate:Cascade)
  ratings Rating[]
  orderItems OrderItem[]
  @@index([typeId])
  @@map("menus")
}
model User {
  userId Int @id @default(autoincrement()) @db.UnsignedInt
  userName String @unique @db.VarChar(60)
  email String @unique @db.VarChar(190)
  password String @db.VarChar(255)
  role Role @default(user)
  ratings Rating[]
  @@map("users")
}
enum Role {
  user
  admin
}
model Rating {
  userId Int @db.UnsignedInt
  menuId Int @db.UnsignedInt
  score Int @db.UnsignedTinyInt
  user User @relation(fields:[userId],references:[userId],onDelete:Cascade)
  menu Menu @relation(fields:[menuId],references:[menuId],onDelete:Cascade)
  @@id([userId,menuId])
  @@map("ratings")
}
model Order {
  orderId Int @id @default(autoincrement()) @db.UnsignedInt
  customerName String @db.VarChar(180)
  phone String @db.VarChar(20)
  deliveryDate DateTime @db.Date
  deliveryTime DateTime @db.Time(0)
  address String @db.VarChar(255)
  total Decimal @default(0) @db.Decimal(10,2)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  items OrderItem[]
  @@map("orders")
}
model OrderItem {
  orderItemId Int @id @default(autoincrement()) @db.UnsignedInt
  orderId Int @db.UnsignedInt
  menuId Int @db.UnsignedInt
  qty Int @default(1) @db.UnsignedInt
  note String? @default("") @db.VarChar(255)
  price Decimal @db.Decimal(10,2)
  subtotal Decimal @db.Decimal(10,2)
  order Order @relation(fields:[orderId],references:[orderId],onDelete:Cascade,onUpdate:Cascade)
  menu Menu @relation(fields:[menuId],references:[menuId],onDelete:Restrict,onUpdate:Cascade)
  @@index([orderId])
  @@index([menuId])
  @@map("order_items")
}
